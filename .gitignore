# ── Site folders excluded from tracking ──────────────────────────────────────
UTESpac_MATLAB/siteFire1/
UTESpac_MATLAB/siteFire2/

# ── Raw data files (in legacy site folders, any depth: card dumps, 48-h files) ─
site*/**/*.txt
site*/**/*.dat
site*/**/*.TOA5
site*/**/*.toa5
!site*/**/*header*
!site*/output/.gitkeep
UTESpac_MATLAB/site*/*.txt
UTESpac_MATLAB/site*/*.dat

# ── Campbell Scientific card-convert binaries (vendor tools, not redistributed) ──
raw_processing/utils/csidft_convert.exe
raw_processing/utils/csidft.dll

# ── Processed output ──────────────────────────────────────────────────────────
*.pkl
*.mat
*.nc
*.csv

# ── PFinfo (computed coefficients, regenerated on each run) ───────────────────
**/PFinfo.*

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Python packaging build artifacts ───────────────────────────────────────────
*.egg-info/

# ── Comparison logs ────────────────────────────────────────────────────────────
comparison_logs/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.idea/

# ── testbed scratch: assistant working space, never tracked ──────────────────
testbed/scratch/

# ── Local dev notes (not tracked) ─────────────────────────────────────────────
.notes/

# ── Literature library: PDFs and personal Zotero export stay local ────────────
library/*.pdf
library/My Library.bib
library/extracted/
# ── Data tree, task tracker, figures: local only (user ruling 2026-09-07) ─────
# data/* (not a bare "data/") so the README exception below still works --
# a bare "data/" stops git from looking inside it at all, and a negation
# after it has no effect. This includes data/fixtures/: the pinned
# regression fixture carries real site coordinates and a real site code,
# so it stays local like the rest of data/, never git add -f'd.
data/*
!data/README.md
tasks/
*.png
*.pdf
*.log
