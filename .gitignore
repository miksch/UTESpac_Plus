# ── Site folders excluded from tracking ──────────────────────────────────────
UTESpac_MATLAB/siteFire1/
UTESpac_MATLAB/siteFire2/

# ── Raw data files (in legacy site folders, any depth: card dumps, 48-h files) ─
site*/**/*.txt
site*/**/*.dat
site*/**/*.TOA5
site*/**/*.toa5
!site*/**/*header*
!site*/output/.gitkeep
UTESpac_MATLAB/site*/*.txt
UTESpac_MATLAB/site*/*.dat

# ── Processed output ──────────────────────────────────────────────────────────
*.pkl
*.mat
*.nc
*.csv

# ── PFinfo (computed coefficients, regenerated on each run) ───────────────────
**/PFinfo.*

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Comparison logs ────────────────────────────────────────────────────────────
comparison_logs/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.idea/
CLAUDE.md


# ── Data tree (data/<SITE>/...): raw, processed, and reference data stay local.
#    Tracked: the layout README, each site's siteInfo.*, and UTESpac header files.
data/**
!data/README.md
!data/*/
!data/*/siteInfo.toml
!data/*/siteInfo.py
!data/*/siteInfo.m
!data/*/utespac/
!data/*/utespac/*_header.dat

# ── testbed scratch: assistant working space, never tracked ──────────────────
testbed/scratch/

# ── Local dev notes (not tracked) ─────────────────────────────────────────────
.notes/

# ── Literature library: PDFs and personal Zotero export stay local ────────────
library/*.pdf
library/My Library.bib
# -- committed regression fixtures (tests/fixtures/): keep every file, including the PFinfo.json copy
!tests/fixtures/**
