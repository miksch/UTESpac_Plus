# ── Site folders excluded from tracking ──────────────────────────────────────
UTESpac_MATLAB/siteFire1/
UTESpac_MATLAB/siteFire2/

# ── Raw data files (in legacy site folders, any depth: card dumps, 48-h files) ─
site*/**/*.txt
site*/**/*.dat
site*/**/*.TOA5
site*/**/*.toa5
!site*/**/*header*
!site*/output/.gitkeep
UTESpac_MATLAB/site*/*.txt
UTESpac_MATLAB/site*/*.dat

# ── Campbell Scientific card-convert binaries (vendor tools, not redistributed) ──
raw_processing/utils/csidft_convert.exe
raw_processing/utils/csidft.dll

# ── Processed output ──────────────────────────────────────────────────────────
*.pkl
*.mat
*.nc
*.csv

# ── PFinfo (computed coefficients, regenerated on each run) ───────────────────
**/PFinfo.*

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Comparison logs ────────────────────────────────────────────────────────────
comparison_logs/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.idea/


# ── Data tree (data/<SITE>/...): raw, processed, and reference data stay local.
#    Tracked: the layout README, each site's siteInfo.*, and UTESpac header files.
data/**
!data/README.md
!data/*/
!data/*/siteInfo.toml
!data/*/siteInfo.py
!data/*/siteInfo.m
!data/*/utespac/
!data/*/utespac/*_header.dat
!data/*/scripts/
!data/*/scripts/*.py

# ── testbed scratch: assistant working space, never tracked ──────────────────
testbed/scratch/

# ── Local dev notes (not tracked) ─────────────────────────────────────────────
.notes/

# ── Literature library: PDFs and personal Zotero export stay local ────────────
library/*.pdf
library/My Library.bib
library/extracted/
# ── Data tree, task tracker, figures: local only (user ruling 2026-09-07) ─────
# data/* (not a bare "data/") so the exceptions below still work -- a
# bare "data/" stops git from looking inside it at all, and a negation
# after it has no effect. This silently broke both exceptions below
# (nothing under data/fixtures/ was actually tracked) until 2026-09-14.
data/*
!data/README.md
# committed regression fixtures (dev-only like the rest of data/): keep
# every file, including the PFinfo.json copy
!data/fixtures/
!data/fixtures/**
data/fixtures/**/__pycache__/
tasks/
*.png
*.pdf
*.log
